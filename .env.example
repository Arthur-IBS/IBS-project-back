# Django
SECRET_KEY=your_django_secret_key_here
DEBUG=True
 
# PostgreSQL
DB_NAME=logpro_db
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_HOST=localhost
DB_PORT=5432
 
# Elasticsearch
ES_HOST=http://localhost:9200
ES_INDEX_PREFIX=logpro
 
# Logstash
LOGSTASH_HOST=localhost
LOGSTASH_PORT=5000
 
# Agent - App 1 (default)
AGENT_LOG_FILE=C:/path/to/your/logfile.log
AGENT_POSITION_FILE=agent_position.txt
AGENT_INTERVAL_SECONDS=60
AGENT_MAX_RETRIES=3
AGENT_RETRY_DELAY=5
APP_NAME=opsman
 
# ─────────────────────────────────────────────
# For multiple applications create separate .env files
# Example: .env.app2
# Copy this file and change these values:
#
# APP_NAME=app2
# AGENT_LOG_FILE=C:/path/to/app2/logfile.log
# AGENT_POSITION_FILE=agent_position_app2.txt
#
# Run agent for app2:
# python agent.py --env .env.app2
# ─────────────────────────────────────────────
 